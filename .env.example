APP_NAME=AI API Monitoring Platform
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:chinu123@localhost:5432/api_monitor

JWT_SECRET_KEY=my-super-secret-dev-key-change-this-later
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_DELAY_SECONDS=2
FAILURE_THRESHOLD=3
